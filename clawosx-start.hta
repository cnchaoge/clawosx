<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=gb2312">
<title>ClawOSX</title>
<HTA:APPLICATION
  APPLICATIONNAME="ClawOSX"
  VERSION="1.0"
  CAPTION="yes"
  ICON="none"
  BORDER="dialog"
  BORDERSTYLE="normal"
  INNERBORDER="no"
  CONTEXTMENU="no"
  SELECTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  RESIZABLE="yes"
  SCROLL="yes"
  WINDOWSTATE="normal">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: "Segoe UI", Arial, sans-serif;
  background: #1a1a2e;
  color: #eee;
  min-height: 100vh;
  padding: 20px;
}
.container { max-width: 620px; margin: 0 auto; }
h1 { text-align: center; font-size: 32px; margin-bottom: 4px; }
.subtitle { text-align: center; color: #666; font-size: 13px; margin-bottom: 24px; }
.card { background: #16213e; border-radius: 12px; padding: 18px; margin-bottom: 12px; border: 1px solid #0f3460; }
.card h2 { font-size: 13px; color: #00d4ff; margin-bottom: 12px; letter-spacing: 1px; }
.row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.label { font-size: 12px; color: #999; width: 72px; flex-shrink: 0; }
input[type="text"], input[type="password"] {
  flex: 1; padding: 7px 10px; background: #0f3460;
  border: 1px solid #1a4a7a; border-radius: 6px; color: #fff; font-size: 12px;
}
input:focus { outline: none; border-color: #00d4ff; }
select {
  flex: 1; padding: 7px 10px; background: #0f3460;
  border: 1px solid #1a4a7a; border-radius: 6px; color: #fff; font-size: 12px;
}
.status-line { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.status-dot {
  width: 12px; height: 12px; border-radius: 50%;
  background: #555;
}
.status-dot.running { background: #00ff88; box-shadow: 0 0 6px #00ff88; }
.status-dot.stopped { background: #e94560; }
.status-text { font-size: 13px; color: #aaa; }
.toggle-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 7px 0; border-bottom: 1px solid #0f3460;
}
.toggle-row:last-child { border-bottom: none; }
.toggle-label { font-size: 12px; }
.toggle { position: relative; width: 40px; height: 22px; }
.toggle input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute; cursor: pointer; inset: 0;
  background: #333; border-radius: 22px; transition: 0.3s;
}
.slider:before {
  content: ""; position: absolute; height: 16px; width: 16px;
  left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: 0.3s;
}
input:checked + .slider { background: #00d4ff; }
input:checked + .slider:before { transform: translateX(18px); }
.channel-box { background: #0f3460; border-radius: 8px; padding: 10px; margin-bottom: 8px; }
.channel-box h3 { font-size: 12px; margin-bottom: 6px; color: #ccc; }
.btn-row { display: flex; gap: 8px; flex-wrap: wrap; }
button {
  padding: 8px 20px; border: none; border-radius: 8px;
  font-size: 13px; cursor: pointer; transition: all 0.2s; font-weight: bold;
}
.btn-start {
  background: #00ff88; color: #1a1a2e;
  width: 100%; font-size: 15px; padding: 12px; margin-top: 4px;
}
.btn-start:hover { background: #00e67a; }
.btn-save { background: #00d4ff; color: #1a1a2e; }
.btn-save:hover { background: #00b8e6; }
.btn-refresh { background: #555; color: #fff; }
.btn-refresh:hover { background: #666; }
button:disabled { opacity: 0.4; cursor: not-allowed; }
.msg {
  padding: 8px 12px; border-radius: 8px; font-size: 12px;
  margin-bottom: 10px; display: none;
}
.msg-error { background: #4d0a1a; border: 1px solid #e94560; color: #e94560; }
.msg-success { background: #0a4d2e; border: 1px solid #00ff88; color: #00ff88; }
.hidden { display: none; }
.note { font-size: 11px; color: #555; margin-top: 4px; }
.footer { text-align: center; color: #444; font-size: 10px; margin-top: 16px; }
</style>
</head>
<body>
<div class="container">

  <h1>ClawOSX</h1>
  <p class="subtitle">v1.0 - USB Portable AI Agent</p>

  <div id="msg" class="msg"></div>

  <!-- Service Status -->
  <div class="card">
    <h2>SERVICE STATUS</h2>
    <div class="status-line">
      <div id="status-dot" class="status-dot"></div>
      <span id="status-text" class="status-text">Checking...</span>
    </div>
    <div class="btn-row">
      <button id="btn-refresh" class="btn-refresh" onclick="checkStatus()">Refresh</button>
    </div>
  </div>

  <!-- AI Config -->
  <div class="card">
    <h2>AI CONFIG</h2>
    <div class="row">
      <span class="label">Provider</span>
      <select id="ai-provider">
        <option value="minimax">MiniMax</option>
        <option value="openai">OpenAI</option>
        <option value="deepseek">DeepSeek</option>
        <option value="custom">Custom</option>
      </select>
    </div>
    <div class="row">
      <span class="label">API Key</span>
      <input type="password" id="ai-apikey" placeholder="sk-...">
    </div>
    <div class="row">
      <span class="label">Model</span>
      <input type="text" id="ai-model" placeholder="optional">
    </div>
    <div class="btn-row" style="margin-top:8px">
      <button class="btn-save" onclick="saveAI()">Save AI Config</button>
    </div>
    <p class="note">Saved to data/.openclaw/openclaw.json</p>
  </div>

  <!-- Channels -->
  <div class="card">
    <h2>MESSAGE CHANNELS</h2>

    <div class="channel-box">
      <h3>Feishu</h3>
      <div class="toggle-row">
        <span class="toggle-label">Enable</span>
        <label class="toggle">
          <input type="checkbox" id="feishu-en" onchange="toggleFeishu()">
          <span class="slider"></span>
        </label>
      </div>
      <div id="feishu-fields" class="hidden">
        <div class="row" style="margin-top:6px">
          <span class="label">App ID</span>
          <input type="text" id="feishu-appid" placeholder="cli_xxx">
        </div>
        <div class="row">
          <span class="label">App Secret</span>
          <input type="password" id="feishu-secret" placeholder="App Secret">
        </div>
      </div>
    </div>

    <div class="channel-box">
      <h3>Telegram</h3>
      <div class="toggle-row">
        <span class="toggle-label">Enable</span>
        <label class="toggle">
          <input type="checkbox" id="tg-en" onchange="toggleTg()">
          <span class="slider"></span>
        </label>
      </div>
      <div id="tg-fields" class="hidden">
        <div class="row" style="margin-top:6px">
          <span class="label">Bot Token</span>
          <input type="password" id="tg-token" placeholder="123456:ABC...">
        </div>
      </div>
    </div>

    <div class="btn-row" style="margin-top:6px">
      <button class="btn-save" onclick="saveChannels()">Save Channels</button>
    </div>
  </div>

  <!-- Service -->
  <div class="card">
    <h2>SERVICE SETTINGS</h2>
    <div class="row">
      <span class="label">Port</span>
      <input type="text" id="svc-port" value="18789">
    </div>
    <p class="note">Must match port in Windows-Start.bat</p>
  </div>

  <!-- Start / Stop -->
  <div>
    <button class="btn-start" id="btn-start" onclick="handleStartStop()">Start ClawOSX</button>
  </div>

  <div class="footer">ClawOSX v1.0 - All data stored on USB drive</div>
</div>

<script>
// JScript helpers (no .trim() in JScript)
function trim(s) {
  return String(s).replace(/^\s+|\s+$/g, "");
}
function exists(path) {
  try { return fso.FileExists(path); } catch(e) { return false; }
}
function mkdir(path) {
  try {
    if (!fso.FolderExists(path)) fso.CreateFolder(path);
    return true;
  } catch(e) { return false; }
}
function readFile(path) {
  try {
    var stream = fso.OpenTextFile(path, 1);
    var content = stream.ReadAll();
    stream.Close();
    return content;
  } catch(e) { return ""; }
}
function writeFile(path, content) {
  try {
    if (fso.FileExists(path)) fso.DeleteFile(path);
    var stream = fso.CreateTextFile(path, true);
    stream.Write(content);
    stream.Close();
    return true;
  } catch(e) { return false; }
}

var fso = new ActiveXObject("Scripting.FileSystemObject");
var shell = new ActiveXObject("WScript.Shell");

var htaPath = unescape(document.location.pathname);
var localPath = htaPath.replace(/\\/g, "\\\\").replace(/[^\\\\]+$/, "").replace(/\/$/, "");
if (localPath.charAt(localPath.length - 1) !== "\\") localPath += "\\";

var DATA_DIR = localPath + "data\\";
var STATE_DIR = DATA_DIR + ".openclaw\\";
var OPENCLAW_JSON = STATE_DIR + "openclaw.json";

var serviceRunning = false;
var currentPort = 18789;

// Check port via PowerShell TcpClient
function checkPort(port) {
  var tmpFile = localPath + "data\\portcheck.txt";
  mkdir(localPath + "data\\");
  writeFile(tmpFile, "");
  // PowerShell script: test port, output "OPEN" or "CLOSED"
  var ps = "try { $t = New-Object System.TcpClient; $t.Connect('127.0.0.1'," + port + "); $t.Close(); Write-Host 'OPEN' } catch { Write-Host 'CLOSED' }";
  shell.Run('powershell -ExecutionPolicy Bypass -Command "try { $t = New-Object System.TcpClient; $t.Connect(\\'127.0.0.1\\',' + port + '); $t.Close(); Write-Host \\'OPEN\\' } catch { Write-Host \\'CLOSED\\' }" > "' + tmpFile.replace(/\\/g, "\\\\") + '" 2>&1', 0, true);
  var result = trim(readFile(tmpFile));
  return result === "OPEN";
}

function showMsg(text, type) {
  var m = document.getElementById("msg");
  m.className = "msg msg-" + type;
  m.innerText = text;
  m.style.display = "block";
  setTimeout(function() { m.style.display = "none"; }, 3000);
}
function toggleFeishu() {
  var en = document.getElementById("feishu-en").checked;
  document.getElementById("feishu-fields").className = en ? "" : "hidden";
}
function toggleTg() {
  var en = document.getElementById("tg-en").checked;
  document.getElementById("tg-fields").className = en ? "" : "hidden";
}

function checkStatus() {
  var port = trim(document.getElementById("svc-port").value) || "18789";
  currentPort = port;
  var dot = document.getElementById("status-dot");
  var text = document.getElementById("status-text");
  var btn = document.getElementById("btn-start");
  var running = checkPort(port);
  if (running) {
    dot.className = "status-dot running";
    text.innerText = "Running on port " + port;
    btn.innerText = "Stop ClawOSX";
    btn.style.background = "#e94560";
    serviceRunning = true;
  } else {
    dot.className = "status-dot stopped";
    text.innerText = "Stopped";
    btn.innerText = "Start ClawOSX";
    btn.style.background = "#00ff88";
    serviceRunning = false;
  }
}

function handleStartStop() {
  checkStatus();
  if (serviceRunning) {
    shell.Run("taskkill /f /im node.exe", 0, true);
    showMsg("ClawOSX stopped", "success");
    setTimeout(checkStatus, 1500);
  } else {
    var port = trim(document.getElementById("svc-port").value) || "18789";
    var startBat = localPath + "Windows-Start.bat";
    if (!exists(startBat)) {
      showMsg("Windows-Start.bat not found", "error");
      return;
    }
    mkdir(localPath + "data\\.openclaw\\");
    writeFile(localPath + "data\\.openclaw\\port.txt", port);
    shell.Run('"' + startBat + '"', 1, false);
    showMsg("ClawOSX starting...", "success");
    setTimeout(checkStatus, 3000);
  }
}

function loadConfig() {
  if (!exists(OPENCLAW_JSON)) return;
  var content = readFile(OPENCLAW_JSON);
  try {
    var cfg = JSON.parse(content);
    var providers = cfg.models && cfg.models.providers ? cfg.models.providers : {};
    var keys = [];
    for (var k in providers) { if (providers.hasOwnProperty(k)) keys.push(k); }
    if (keys.length > 0) {
      var p = providers[keys[0]];
      document.getElementById("ai-provider").value = keys[0];
      document.getElementById("ai-apikey").value = p.apiKey || "";
      document.getElementById("ai-model").value = p.model || "";
    }
    var feishu = cfg.channels && cfg.channels.feishu ? cfg.channels.feishu : {};
    if (feishu.appId || feishu.appSecret) {
      document.getElementById("feishu-en").checked = feishu.enabled ? true : false;
      document.getElementById("feishu-appid").value = feishu.appId || "";
      document.getElementById("feishu-secret").value = feishu.appSecret || "";
      toggleFeishu();
    }
    var tg = cfg.channels && cfg.channels.telegram ? cfg.channels.telegram : {};
    if (tg.botToken) {
      document.getElementById("tg-en").checked = tg.enabled ? true : false;
      document.getElementById("tg-token").value = tg.botToken || "";
      toggleTg();
    }
  } catch(e) {}
}

function saveAI() {
  var provider = document.getElementById("ai-provider").value;
  var apiKey = trim(document.getElementById("ai-apikey").value);
  var model = trim(document.getElementById("ai-model").value);
  if (!apiKey) { showMsg("Please enter API Key", "error"); return; }
  mkdir(STATE_DIR);
  var cfg = {};
  if (exists(OPENCLAW_JSON)) {
    try { cfg = JSON.parse(readFile(OPENCLAW_JSON)); } catch(e) { cfg = {}; }
  } else {
    cfg = { gateway:{mode:"local",auth:{mode:"none"}}, models:{mode:"merge",providers:{}}, agents:{defaults:{}} };
  }
  if (!cfg.models) cfg.models = { mode:"merge", providers:{} };
  if (!cfg.models.providers) cfg.models.providers = {};
  cfg.models.providers[provider] = { apiKey: apiKey };
  if (model) cfg.models.providers[provider].model = model;
  if (writeFile(OPENCLAW_JSON, JSON.stringify(cfg, null, 2))) {
    showMsg("AI config saved!", "success");
  } else {
    showMsg("Save failed", "error");
  }
}

function saveChannels() {
  mkdir(STATE_DIR);
  var cfg = {};
  if (exists(OPENCLAW_JSON)) {
    try { cfg = JSON.parse(readFile(OPENCLAW_JSON)); } catch(e) { cfg = {}; }
  } else {
    cfg = { gateway:{mode:"local",auth:{mode:"none"}}, models:{mode:"merge",providers:{}}, agents:{defaults:{}} };
  }
  if (!cfg.channels) cfg.channels = {};
  var feishuEn = document.getElementById("feishu-en").checked;
  var feishuAppid = trim(document.getElementById("feishu-appid").value);
  var feishuSecret = trim(document.getElementById("feishu-secret").value);
  if (feishuEn && feishuAppid && feishuSecret) {
    cfg.channels.feishu = { enabled: true, appId: feishuAppid, appSecret: feishuSecret };
  } else {
    cfg.channels.feishu = { enabled: false };
  }
  var tgEn = document.getElementById("tg-en").checked;
  var tgToken = trim(document.getElementById("tg-token").value);
  if (tgEn && tgToken) {
    cfg.channels.telegram = { enabled: true, botToken: tgToken };
  } else {
    cfg.channels.telegram = { enabled: false };
  }
  if (writeFile(OPENCLAW_JSON, JSON.stringify(cfg, null, 2))) {
    showMsg("Channels saved!", "success");
  } else {
    showMsg("Save failed", "error");
  }
}

// Init
setTimeout(checkStatus, 500);
setTimeout(loadConfig, 800);
</script>
</body>
</html>